# Docker Compose binds localhost only by default. Use a TLS reverse proxy for external access.
BIND_ADDRESS=127.0.0.1
PORT=8001
ENVIRONMENT=production
LOG_LEVEL=info
TZ=Asia/Hong_Kong

# Optional in the isolated Compose network. Set a strong value for shared networks.
REDIS_PASSWORD=
REDIS_DB=0

# Go time.ParseDuration values, NOT bare seconds:
VIDEO_INFO_TTL=1h
STREAM_URL_TTL=5m

SMART_PROXY_ENABLED=true
PROXY_COUNTRIES=CN
DEFAULT_STREAM_MODE=direct

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW=60
RATE_LIMIT_BY_IP=true

# Enable with strong keys before exposing the API on the Internet.
API_KEY_ENABLED=false
# Keep empty: local reverse proxy connections must not bypass API keys.
API_KEY_EXEMPT_IPS=
API_KEYS=
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
